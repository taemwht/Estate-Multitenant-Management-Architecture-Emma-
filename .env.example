# Copy to .env (git-ignored) and fill in. ONE file holds every secret:
# Emma (./docker-compose.yml), the API (api/), and the demo (demo/).

POSTGRES_PASSWORD=CHANGE_ME

# Emma agent: the API account (company_admin) Emma logs in as
EMMA_API_EMAIL=CHANGE_ME
EMMA_API_PASSWORD=CHANGE_ME

# API -> real property_platform DB, as app_platform (never postgres).
DATABASE_URL=postgresql://app_platform:CHANGE_ME@localhost:5432/property_platform
# Same database as seen from inside Docker (the api service in docker-compose.yml)
API_DOCKER_DATABASE_URL=postgresql://app_platform:CHANGE_ME@host.docker.internal:5432/property_platform
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo stack (demo/): its own throwaway database
DEMO_SUPERUSER_PASSWORD=CHANGE_ME
DEMO_APP_DB_PASSWORD=CHANGE_ME
DEMO_JWT_SECRET=CHANGE_ME
DEMO_CORS_ORIGINS=https://property-web-xi.vercel.app

# EMMA chat (api/app/chat)
OPENAI_API_KEY=
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-6-luna
CHAT_TIMEZONE=America/Los_Angeles

# Telegram bot (from @BotFather), and which API runs it: demo or real
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_FOR=demo
